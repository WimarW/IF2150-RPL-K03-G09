# Backend Server
PORT=5000
NODE_ENV=development

# Database PostgreSQL (port 5433 sesuai mapping "5433:5432" di src/docker-compose.yml)
DATABASE_URL="postgresql://cariuang_user:cariuang_password@localhost:5433/cariuang_db?schema=public"

# JWT Auth (ganti dengan string acak minimal 32 karakter)
JWT_SECRET="masukkan_jwt_secret_acak_di_sini_minimal_32_karakter"
JWT_EXPIRES_IN="7d"

# Frontend / Docker Compose (opsional, sesuaikan untuk HP fisik / emulator)
# REACT_NATIVE_PACKAGER_HOSTNAME=localhost
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
